CompileFlags:
  Add: 
    - -std=c++23 # C++20의 복잡한 constexpr 체크를 피하기 위해 c++17을 권장합니다. (C++23으로 업데이트됨)
    - -Wall
    - -Wextra
    - -Wno-unused-value
    - -Wno-sign-compare
    - -ferror-limit=0
    - -nostdinc++
    - -isystem
    - /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include

Diagnostics:
  UnusedIncludes: None
  # 시스템 헤더에서 발생하는 호환성 에러들을 무시하도록 추가합니다.
  Suppress: 
    - "constexpr-function-never-constant"
    - "invalid-constexpr"
    - "keyword-macro"
    - "format-security"

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add: [-xc++-header]
